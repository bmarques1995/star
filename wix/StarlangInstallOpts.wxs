<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="StarlangInstallOpts">
      <Dialog Id="StarlangInstallOpts" Width="370" Height="270" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="30" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installation Options"/>
        <Control Id="Subtitle" Type="Text" X="25" Y="18" Width="340" Height="16" Transparent="yes" NoPrefix="yes" Text="Choose the options you want to enable:"/>
        <Control Id="Line" Type="Line" X="0" Y="44" Width="370" Height="1"/>
        <!-- PATH -->
        <Control Id="AddToPath" Type="CheckBox" X="20" Y="72" Width="330" Height="18" Property="STARLANG_ADD_TO_PATH" CheckBoxValue="1" Text="Add Starlang to PATH"/>
        <!-- Desktop -->
        <Control Id="DesktopShortcut" Type="CheckBox" X="20" Y="105" Width="330" Height="18" Property="STARLANG_DESKTOP_SHORTCUT" CheckBoxValue="1" Text="Create a shortcut on the Desktop"/>
        <!-- Start Menu -->
        <Control Id="StartMenuShortcut" Type="CheckBox" X="20" Y="138" Width="330" Height="18" Property="STARLANG_STARTMENU_SHORTCUT" CheckBoxValue="1" Text="Create a shortcut in the Start Menu"/>
        <!-- Back -->
        <Control Id="Back" Type="PushButton" X="172" Y="243" Width="56" Height="17" Text="Back">
            <Publish Event="NewDialog" Value="InstallDirDlg"/>
        </Control>
        <!-- Next -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
            <Publish Event="NewDialog" Value="VerifyReadyDlg"/>
        </Control>
        <!-- Cancel -->
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
            <Publish Event="EndDialog" Value="Exit"/>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
