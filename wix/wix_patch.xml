<CPackWiXPatch>
    <CPackWiXFragment Id="CM_DP_bin">
        <!-- PATH -->
        <Component Id="StarlangPathEntryCMP" KeyPath="yes" Guid="0E782367-5D68-4539-81D1-B9757AE496A1" Condition="STARLANG_ADD_TO_PATH">
            <Environment Id="CMakeSystemPathEntryENV" Action="set" Part="last" Name="PATH" Value="[INSTALL_ROOT]bin" System="yes" />
        </Component>
        <!-- Desktop shortcut -->
        <Component Id="StarlangDesktopShortcut" Directory="DesktopFolder" Condition="STARLANG_DESKTOP_SHORTCUT" Guid="A5B9C2A1-0A4A-4A45-9F4E-111111111111">
            <Shortcut Id="StarlangDesktopShortcut" Name="Starlang" Description="Starlang" Target="[INSTALL_ROOT]bin\star.exe" WorkingDirectory="INSTALL_ROOT" />
            <RegistryValue Root="HKCU" Key="Software\Starlang" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <!-- Start Menu shortcut -->
        <Component Id="StarlangStartMenuShortcut" Directory="ProgramMenuFolder" Condition="STARLANG_STARTMENU_SHORTCUT" Guid="C8E5B0D2-2E7B-45A3-BF22-222222222222">
            <Shortcut Id="StarlangStartMenuShortcut" Name="Starlang" Description="Starlang" Target="[INSTALL_ROOT]bin\star.exe" WorkingDirectory="INSTALL_ROOT" />
            <RegistryValue Root="HKCU" Key="Software\Starlang" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
    </CPackWiXFragment>
    <CPackWiXFragment Id="#PRODUCTFEATURE">
        <ComponentRef Id="StarlangPathEntryCMP" />
        <ComponentRef Id="StarlangDesktopShortcut" />
        <ComponentRef Id="StarlangStartMenuShortcut" />
    </CPackWiXFragment>
</CPackWiXPatch>